# ── Discord OAuth Application ─────────────────────────────────────
# https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=DEINE_CLIENT_ID
DISCORD_CLIENT_SECRET=DEIN_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://DEINE-APP.onrender.com/auth/callback

# ── Discord Bot (IC-Zeit Tracking) ───────────────────────────────
# → Bot → Token kopieren
DISCORD_BOT_TOKEN=DEIN_BOT_TOKEN
DISCORD_GUILD_ID=DEINE_SERVER_ID

# Bot ↔ Server Authentifizierung (beliebiger langer String)
BOT_API_SECRET=aendere_mich_zu_einem_geheimen_string

# IC-Kanal Schlüsselwörter (kommagetrennt)
IC_CHANNEL_KEYWORDS=IC,Dienst,Fahrstunde,Prüfung,Service,Einsatz
TRACK_ALL_CHANNELS=false

# ── Server ────────────────────────────────────────────────────────
PORT=3000
SESSION_SECRET=aendere_mich_zu_einem_langen_zufaelligen_string
NODE_ENV=production

# ── Datenbank ─────────────────────────────────────────────────────
# Lokal: weglassen (nutzt acls.db im Projektordner)
# Render mit Persistent Disk: /data/acls.db
DB_PATH=/data/acls.db

# ── Bot → Server URL (nur nötig wenn Bot separat läuft) ───────────
SERVER_URL=https://DEINE-APP.onrender.com
