# ═══════════════════════════════════════════════════════════════
#  ACLS Website – Umgebungsvariablen
#  Kopiere diese Datei zu .env und fülle alle Werte aus.
#  Trage dieselben Werte in den Railway-Service ein (Variables-Tab).
# ═══════════════════════════════════════════════════════════════

# ── Discord OAuth (Login-Button auf der Website) ────────────────
# https://discord.com/developers/applications → deine App → OAuth2
DISCORD_CLIENT_ID=DEINE_CLIENT_ID
DISCORD_CLIENT_SECRET=DEIN_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://DEINE-RAILWAY-URL.up.railway.app/auth/callback

# ── Discord Bot (IC-Zeit Tracking + Namen-Sync) ─────────────────
# https://discord.com/developers/applications → deine App → Bot → Reset Token
DISCORD_BOT_TOKEN=DEIN_BOT_TOKEN

# Discord Server-ID (Rechtsklick auf Server → ID kopieren, Entwicklermodus an)
DISCORD_GUILD_ID=1476285849309024474

# ── Bot ↔ Server Authentifizierung ─────────────────────────────
# Beliebiger langer geheimer String – muss in beiden Diensten identisch sein
BOT_API_SECRET=aendere_mich_zu_einem_langen_geheimen_string

# ── Website-URL (damit der Bot den Server erreicht) ─────────────
# Deine Railway-URL, z.B. https://acls-production-xxxx.up.railway.app
SERVER_URL=https://DEINE-RAILWAY-URL.up.railway.app

# ── IC-Kanal Einstellungen ──────────────────────────────────────
# Kanalnamen die diese Wörter enthalten werden als IC-Zeit gezählt
IC_CHANNEL_KEYWORDS=IC,Dienst,Fahrstunde,Prüfung,Service,Einsatz
# true = alle Voice-Kanäle tracken, false = nur Keywords
TRACK_ALL_CHANNELS=false

# ── Öffentliche Kontaktdaten (Login-Screen & Werkstatt-Seite) ────
# Discord-Einladungslink (leer = Button wird ausgeblendet)
DISCORD_INVITE_URL=
# IC-Telefonnummer / Erreichbarkeit der Werkstatt
ACLS_IC_PHONE=Im LS-Telefonbuch unter „ACLS“
# Standort-Beschreibung des Hauptquartiers
ACLS_HQ_TEXT=ACLS Hauptquartier, Los Santos
# Dienstzeiten-Text (der Live-Status kommt automatisch aus der IC-Zeit)
ACLS_DIENSTZEITEN=Immer wenn Mitarbeiter IC im Dienst sind – Status live auf der Website

# ── Server ──────────────────────────────────────────────────────
PORT=3000
SESSION_SECRET=aendere_mich_zu_einem_langen_zufaelligen_string
NODE_ENV=production

# ── Datenbank (nur auf Railway/Render mit Persistent Disk nötig) ─
# Lokal weglassen – nutzt dann acls.db im Projektordner
DB_PATH=/app/data/acls.db

# ── Admin-Seed (optional) ───────────────────────────────────────
# Wird beim ersten Start automatisch als Admin angelegt
ADMIN_DISCORD_IDS=DEINE_DISCORD_ID
ADMIN_USERNAMES=DeinName

# ── Bot-Channel-IDs (optional) ──────────────────────────────────
# Begrüßung neuer Mitglieder (leer = nur DM, keine Channel-Nachricht)
WELCOME_CHANNEL_ID=
# Geburtstags-Glückwünsche (Fallback: EOW_CHANNEL_ID)
BIRTHDAY_CHANNEL_ID=

# ── Bewerbungs-/Ticket-System ────────────────────────────────────
# Channel, den neue (unverifizierte) Mitglieder sehen — dort steht
# das Panel mit "Bewerben" / "Sonstiges Anliegen" (per /ticket-panel posten)
GATE_CHANNEL_ID=
# Kategorie, in der neue Ticket-Kanäle angelegt werden (leer = oberste Ebene)
TICKET_CATEGORY_ID=
# Kategorie, in die entschiedene/geschlossene Tickets verschoben werden
# (leer = Kanal bleibt umbenannt+gesperrt an Ort und Stelle liegen)
ARCHIVE_CATEGORY_ID=
# Rolle, die Bewerbungs-Tickets sieht und annehmen/ablehnen kann
LEADER_ROLE_NAME=Leader
# Rolle für "Sonstiges Anliegen"-Tickets (leer = gleich wie LEADER_ROLE_NAME)
SUPPORT_ROLE_NAME=
# Rolle, die bei Annahme einer Bewerbung automatisch vergeben wird
AUTO_ROLE_NAME=ACLS Member
